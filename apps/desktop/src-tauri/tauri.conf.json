{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeshMind",
  "version": "0.1.0",
  "identifier": "dev.meshmind.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "MeshMind", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 500 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
